# Chatbot name (shown in UI and responses)
CHATBOT_NAME=Riko

# Flask
SECRET_KEY=<some big key that nobody can guess>
# 0-Disabled
# 1-Enabled
FLASK_DEBUG=0
PORT=5002

# Optional: custom upload directory for images (default: ./uploads)
UPLOAD_FOLDER=./uploads
AGENT_URL=http://localhost:5010
MAX_HISTORY_TURNS=20
MAX_CONTENT_KENGTH=16 * 1024 * 1024  # 16 MB max upload
ALLOWED_EXTENSIONS={"png", "jpg", "jpeg", "gif", "webp"}

# if not to STDOUT, then to the log file
LOG_TO_STDOUT=True
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG
